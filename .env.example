# Copy this file to .env and set a unique local password before starting Compose.
DB_PASSWORD=change-me-locally
DB_USER=appuser
DB_NAME=nmapdb

# Empty means scan requests are denied. Add only exact targets you are authorized to scan.
SCAN_ALLOWED_TARGETS=127.0.0.1,::1

# Optional host port for PostgreSQL; defaults to 5432.
POSTGRES_HOST_PORT=5432
